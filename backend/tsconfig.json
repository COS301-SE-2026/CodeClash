{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "types": [
      "ts-node",
      "jest"
    ],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "root/*": [
        "../*"
      ]
    }
  },
  "include": [
    "src",
    "root"
  ],
}