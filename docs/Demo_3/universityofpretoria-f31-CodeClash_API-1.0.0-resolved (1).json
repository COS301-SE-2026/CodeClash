  "components": {
    "schemas": {
      "EloRating": {
        "type": "object",
        "properties": {
          "rating": {
            "minimum": 0,
            "type": "integer",
            "format": "int32",
            "readOnly": true,
            "example": 600
          }
        }
      },
      "inline_response_200": {
        "type": "object",
        "properties": {
          "<stat>": {
            "type": "string"
          }
        }
      },
      "inline_response_400": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "default": "Invalid request"
          }
        }
      },
      "inline_response_404": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "default": "User not found"
          }
        }
      },
      "inline_response_200_1": {
        "type": "object",
        "properties": {
          "invite_id": {
            "type": "string"
          },
          "friends": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/inline_response_200_1_friends"
            }
          },
          "game_mode": {
            "type": "string",
            "enum": [
              "math",
              "prog"
            ]
          }
        }
      },
      "friend_invite_body": {
        "required": [
          "friends",
          "game_mode",
          "user_id"
        ],
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "friends": {
            "minItems": 1,
            "type": "array",
            "items": {}
          },
          "game_mode": {
            "type": "string",
            "enum": [
              "math",
              "programming"
            ]
          }
        }
      },
      "inline_response_200_2": {
        "type": "object",
        "properties": {
          "invite_id": {
            "type": "string"
          }
        }
      },
      "inline_response_404_1": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "default": "Friend Not Found"
          }
        }
      },
      "inline_response_200_1_friends": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "elo": {
            "type": "integer"
          }
        }
      }
