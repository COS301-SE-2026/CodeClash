{
  "name": "CodeClash-CI",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "frontend": "npm run dev --prefix frontend",
    "backend": "npm run dev --prefix backend",
    "dev": "npm run frontend && npm run backend",
    "test:backend": "cd backend && npx vitest run",
    "test:backend:coverage": "cd backend && npx vitest run --coverage",
    "test:frontend": "cd frontend && NODE_OPTIONS=--no-experimental-webstorage npx vitest run",
    "test:frontend:coverage": "cd frontend && NODE_OPTIONS=--no-experimental-webstorage npx vitest run --coverage",
    "lint": "npm run lint --prefix frontend && npm run lint --prefix backend",
    "lint:staged": "lint-staged",
    "prepare": "husky"
  },
  
  "lint-staged": {
    "frontend/src/*/.{ts,tsx}": "eslint --fix",
    "backend/src/*/.{ts,tsx}": "eslint --fix"
  },
  
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.15",
    "@types/redis": "^4.0.10",
    "autoprefixer": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.0",
    "eslint-plugin-jsdoc": "^63.0.8",
    "eslint-plugin-unicorn": "^69.0.0",
    "globals": "^17.0.0",
    "husky": "^9.0.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.0.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "color-convert": "^3.1.3",
     "aws-amplify": "^6.18.0",
    "jest": "^30.4.2",
    "mock-socket": "^9.3.1",
    "ws": "^8.21.0"
  }
}