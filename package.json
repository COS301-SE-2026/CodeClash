{
  "name": "CodeClash-CI",
  "version": "1.0.0",
  "scripts": {
    "test": "vitest",
    "frontend": "npm run dev --prefix frontend",
    "backend": "npm run dev --prefix backend",
    "dev": "npm run frontend && npm run backend",
